# Upstream sources -- bootstrap.sh clones these at the SHAs in setup/pins.env.
# Never commit them: they are separate git repos and would become broken
# embedded repos / gitlinks.
/prism-research/
/kvcached/
/kvcached-prism/

# Virtualenvs (prism-venv is ~15 GB, sglang-pip-venv ~12 GB)
/prism-venv/
*/engine_integration/sglang-pip-venv/
__pycache__/
*.pyc

# Model weights live in $HF_HOME, not here
*.safetensors
*.bin
*.pth

# Setup transcripts -- large and machine-specific
/setup_prism_env.log
/setup_sglang.log
/dl_models.log

# Server logs: regenerated on every run, ~14 MB
/exp/server-logs/

# Bulk results from exploratory runs. The sanity sweep under
# exp/results/sanity/ IS committed (see the un-ignore rules below).
/exp/results/requests/
/exp/results/*_all.jsonl

# IPC sockets/fifos the scheduler drops in the benchmark dir
gpu_scheduler_*_to_worker_*
request_handler_to_gpu_scheduler_*

# redis snapshots -- redis-server writes these into whatever cwd it started in
dump.rdb

# Bootstrap transcript -- large and machine-specific, like the other setup logs
/bootstrap.log

# Placement configs emitted by exp/scripts/make_config.py -- regenerated on demand
/exp/configs/llama_*gpu_*model_*.json

# Paper-Faithful comparison: ignore the loose bulk, keep the archived copy.
# Per-run server logs and request dumps are 141 MB uncompressed across the 18 runs,
# but ~12x compressible, so each run's pair is committed as logs.tar.gz (~1 MB) and
# only the expanded directories are ignored. Nothing is discarded: diagnose_pf.py's
# round statistics and per-decile TTFT are recomputable from these archives.
#   tar -xzf <run>/logs.tar.gz -C <run>
/exp/results/paper-faithful-comparison/raw/*/*/*/server-logs/
/exp/results/paper-faithful-comparison/raw/*/*/*/requests/
/exp/results/paper-faithful-comparison/raw/*/*/*/*_output_requests.json
/exp/results/paper-faithful-comparison/raw/_profiling/server-logs/
/exp/results/paper-faithful-comparison/raw/_profiling/requests/
/exp/results/paper-faithful-comparison/raw/_smoke/*/server-logs/
/exp/results/paper-faithful-comparison/raw/_smoke/*/requests/

# --- paper-faithful-v2 ---------------------------------------------------
# Workload pickles carry raw ShareGPT prompt TEXT. That text is third-party
# content and some conversations in the dataset contain real leaked credentials
# (GitHub push protection flagged a Slack webhook inside one of ours), so the
# pickles must not be redistributed here. They are fully regenerable:
#   python exp/scripts/build_paired_workload.py --rate R --seed S --duration D \
#     --slo-base exp/configs/v2/slo_base.json --outdir exp/workloads/paper-faithful-v2
# and paired_requests_*.json / phases_*.json (both committed) record everything
# needed to verify the pair -- ids, per-model counts, prompt/output lengths and
# the full phase schedule -- without carrying the prompt bodies.
# every workload pickle, wherever it lands (results/sanity/workloads too)
*.pkl

# Per-run request dumps and server logs: bulky, and the dumps carry prompt
# lengths per request for thousands of requests. metrics.json, META.txt and
# scheduler_proof.txt keep everything the report cites.
/exp/results/paper-faithful-v2/**/requests/
/exp/results/paper-faithful-v2/**/server-logs/

# --- paper-faithful-v3 ---------------------------------------------------
# Keep canonical metrics/proofs and generated report artifacts. Expanded
# request dumps/server logs and diagnostic retry archives remain local.
/exp/results/paper-faithful-v3/**/requests/
/exp/results/paper-faithful-v3/**/server-logs/
/exp/results/paper-faithful-v3/raw/**/seed_*_failed*/
/exp/results/paper-faithful-v3/raw/**/seed_*_invalid*/
/exp/results/paper-faithful-v3/raw/**/.seed_*
